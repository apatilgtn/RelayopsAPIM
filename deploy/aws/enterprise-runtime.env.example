# Store the populated file outside source control with mode 0600.
# Common control-plane settings (keep existing database and secret providers):
RELAYOPS_DATABASE_URL=postgres://REPLACE_WITH_EXISTING_PROVIDER_CONNECTION
RELAYOPS_ADMIN_TOKEN=REPLACE_WITH_UNIQUE_RANDOM_32_OR_MORE_CHARACTERS
RELAYOPS_DATAPLANE_SIGNING_KEY=REPLACE_WITH_BASE64_ED25519_SEED
RELAYOPS_GATEWAY_URL=https://api.example.com
RELAYOPS_NODE_ID=aws-control-a
# Gateway settings (one separate file and unique credential per host):
RELAYOPS_CONTROL_PLANE_URL=https://control.internal.example.com
RELAYOPS_DATAPLANE_TOKEN=rlnode_REPLACE_WITH_ISSUED_NODE_CREDENTIAL
RELAYOPS_DATAPLANE_VERIFY_KEYS=REPLACE_WITH_BASE64_PUBLIC_KEY
RELAYOPS_REDIS_URL=rediss://REPLACE_WITH_SHARED_DISTRIBUTED_LIMITER
# Keep secret-provider settings from the existing deployment. Back up provider
# configuration and recovery keys through the authorized procedure separately.
