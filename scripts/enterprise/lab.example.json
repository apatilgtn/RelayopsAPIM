  "control_endpoints": [{"ip": "10.0.10.30", "port": 443}, {"ip": "10.0.20.30", "port": 443}],
  "probe_url": "https://LAB-API.example.com/health/authorized",
  "fault_seconds": 30,
  "duration_seconds": 120,
  "interval_seconds": 0.25,
  "upgrade_image": "registry.example.com/relayops@sha256:REPLACE_WITH_VERIFIED_DIGEST",
  "workload": {"concurrency": 1, "payload_bytes": 0, "authentication": "api_key", "release": "FILL_IN", "environment": "two-AZ EC2, existing DB/secret provider, shared Redis"},
  "acceptance": {"max_error_rate_percent": 1, "max_p95_ms": 1000, "max_rto_seconds": 120, "max_rpo_seconds": 60, "max_log_loss": 0, "max_convergence_seconds": 30, "status": "example criteria; approve before execution"}
