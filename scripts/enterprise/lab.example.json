{
  "isolated_lab": true,
  "lab_id": "relayops-certification-lab",
  "control_planes": ["i-CONTROL_A", "i-CONTROL_B"],
  "gateways": ["i-GATEWAY_A", "i-GATEWAY_B"],
  "replacement_instance": "i-SAME_AZ_SPARE",
  "restore_instance": "i-FRESH_RECOVERY_LAB",
  "recovery_volume": "vol-RETAINED_GATEWAY_A",
  "gateway_target_group": "arn:aws:elasticloadbalancing:REGION:ACCOUNT:targetgroup/LAB/ID",
